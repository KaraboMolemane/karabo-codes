{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@karabo-codes/nav-bar": [
        "libs/frontend/common/ui-components/src/index.ts"
      ],
      "@karabo-codes/ui-not-found": [
        "libs/frontend/common/ui-not-found/src/index.ts"
      ],
      "@portfolio2/shared/layout": [
        "libs/portfolio2/shared/layout/src/index.ts"
      ],
      "@portfolio2/shared/ui-components": [
        "libs/portfolio2/shared/ui-components/src/index.ts"
      ],
      "@portfolio2/shared/not-found": [
        "libs/portfolio2/shared/not-found/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
